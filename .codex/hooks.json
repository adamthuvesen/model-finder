{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.agents/hooks/post_edit.sh\" codex"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/.venv/bin/python\" -m model_finder.cli.guard codex \"$(git rev-parse --show-toplevel)\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
