__pycache__/
*.py[oc]
.venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.hypothesis/
.DS_Store
.coverage
.import_linter_cache/
coverage.xml
htmlcov/
build/
dist/
*.egg-info/

# The committed replay lives under examples/ instead.
experiments/**/outputs/replay.html

# Runtime artifacts
experiments/**/*.lock
experiments/**/status.md
experiments/**/__pycache__/

# Note: experiments/<exp>/work/ is intentionally NOT gitignored. Intermediate
# artifacts and run evidence form part of the reproducible research record.
# If an experiment generates very large intermediate files, ignore them by name there.

# Local artifacts
experiments/**/*.ipynb
experiments/**/*.csv
experiments/**/*.parquet

# Local-only agent configs
# Ignore .agents/ contents (not the dir itself, so the negations below can recurse)
.agents/*
!.agents/docs/
!.agents/skills/
.cursor/
.claude/scheduled_tasks.lock

# Verification evidence
.verify/
